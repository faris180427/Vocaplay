{
  "name": "vocaplay",
  "version": "1.0.0",
  "private": true,
  "description": "Vocaplay - Learn and Fun (frontend build & test tooling)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "test:unit": "node --test \"tests/js/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.17"
  }
}
